NODE_ENV=development
# true: npm run dev inicia o PostgreSQL exclusivo do projeto e aplica migrations.
LOCAL_DATABASE=true
PORT=3000
APP_TIMEZONE=America/Fortaleza
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
# npm run db:local:setup preenche a conexão local automaticamente.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/licitamatch
# URL direta (sem -pooler) para migrations. Vazio utiliza DATABASE_URL.
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_48_CARACTERES
# Seed opcional, exclusivamente em development. Nunca usa senha padrão.
SEED_USER_ROLE=admin
SEED_USER_EMAIL=admin@local.test
SEED_USER_PASSWORD=

# Processamento e fontes. Compras.gov fica ativo por padrão, inclusive em produção.
WORKER_ENABLED=true
SYNC_ENABLED=true
COMPRASNET_ENABLED=true
SENAC_ENABLED=true
SESC_ENABLED=true
RECIFE_ENABLED=true
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=2
SYNC_MAX_PAGES=5
PNCP_MODALIDADES=4,6,7,8,9,12
COMPRASNET_MODALIDADES=3,5,6,7
# Sem flag explícita, cada canal é ativado ao completar suas credenciais abaixo.
# false desativa o canal; true exige configuração completa.
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=configure-no-ambiente
# EMAIL_FROM=alertas@seu-dominio.com.br
ALERT_MIN_SCORE=70
# Twilio: ativação explícita somente após configurar e testar o Sandbox.
WHATSAPP_ENABLED=false
# Ative somente o webhook para testar boas-vindas sem alertas automáticos.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_MODE=sandbox
WHATSAPP_WEBHOOK_URL=https://licitamatch.online/api/whatsapp/webhook
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=configure-somente-no-ambiente
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Números brasileiros E.164, separados por vírgulas, que aderiram ao Sandbox.
WHATSAPP_SANDBOX_NUMBERS=
# Produção permanece bloqueada até remetente comercial e template aprovados.
WHATSAPP_PRODUCTION_READY=false
# TWILIO_WHATSAPP_CONTENT_SID=HX...

# EMAIL_FROM=alertas@seu-dominio.com.br
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# Brevo: SMTP_HOST=smtp-relay.brevo.com
# Alternative TLS connection: SMTP_PORT=465 and SMTP_SECURE=true
# If SMTP_SECURE is omitted, port 465 uses true; other ports use false.
# SMTP_USER=seu-usuario
# SMTP_PASSWORD=configure-no-ambiente

# Brevo HTTP API takes priority over EMAIL_PROVIDER and SMTP when set.
# BREVO_API_KEY=configure-no-ambiente
# EMAIL_FROM=alertas@seu-dominio.com.br

# Destinatário administrativo para novas solicitações de teste/contratação.
# Sem ADMIN_EMAIL, utiliza os administradores ativos cadastrados.
ADMIN_EMAIL=
