NODE_ENV=development
# true: npm run dev inicia o PostgreSQL exclusivo do projeto e aplica migrations.
LOCAL_DATABASE=true
PORT=3000
APP_TIMEZONE=America/Fortaleza
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
# npm run db:local:setup preenche a conexão local automaticamente.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/licitamatch
# URL direta (sem -pooler) para migrations. Vazio utiliza DATABASE_URL.
DATABASE_DIRECT_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_48_CARACTERES
# Seed opcional, exclusivamente em development. Nunca usa senha padrão.
SEED_USER_ROLE=admin
SEED_USER_EMAIL=admin@local.test
SEED_USER_PASSWORD=AdminLocal!2026
