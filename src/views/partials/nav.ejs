<div class="dashboard-shell">
  <aside class="sidebar" aria-label="Menu lateral">
    <div class="sidebar-brand-wrap"><%- include('logo', { href: '/conta' }) %></div>
    <nav class="sidebar-nav" aria-label="Navegação principal">
      <% const links = [['/busca','Busca por segmento'],['/relatorios','Relatórios'],['/conta','▦ Dashboard'],['/interesses','Interesses'],['/oportunidades','Oportunidades'],['/empresa','Perfil empresarial']];

      if (['gestor', 'admin'].includes(user.tipo)) links.push(['/usuarios','Usuários']);
      if (user.tipo === 'admin') links.push(['/admin','Admin'],['/admin/operacao','Operação e fontes'],['/admin/testes-premium','Testes Premium']);
      for (const [href,label] of links) {
        const active = currentPath === href || (href === '/usuarios' && currentPath.startsWith('/usuarios/')) || (href === '/conta' && currentPath === '/conta/seguranca'); %>
        <a class="nav-link<%= active ? ' active' : '' %>" href="<%= href %>" <% if (active) { %>aria-current="page"<% } %>><%= label %></a>
      <% } %>
      <a class="nav-link" href="/conta#alertas">Alertas</a>
    </nav>
    <div class="sidebar-card"><p>Plano <%= { sem_plano:'Sem plano', start: 'Start', pro: 'Pro', premium: 'Premium' }[user.plano] %></p><h3><%= user.nome_fantasia || user.razao_social || 'Sua empresa' %></h3><p><%= { usuario:'Usuário', gestor:'Gestor', admin:'Administrador' }[user.tipo] %></p></div>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Sair</button></form>
    <img class="sidebar-favsystem-logo" src="/assets/favsystem-logo.png" alt="FAVSYSTEM">
  </aside>
