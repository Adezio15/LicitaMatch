<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="dashboard-shell">
  <aside class="sidebar" aria-label="Menu lateral do dashboard">
    <div class="sidebar-brand-wrap">
      <%- include('../partials/logo', { href: '/conta' }) %>
    </div>
    <nav class="sidebar-nav" aria-label="Navegação principal">
      <a class="nav-link active" href="/conta">Dashboard</a>
      <a class="nav-link" href="/interesses">Interesses</a>
      <a class="nav-link" href="/oportunidades">Oportunidades</a>
      <a class="nav-link" href="/empresa">Empresa</a>
      <% if (['gestor', 'admin'].includes(user.tipo)) { %><a class="nav-link" href="/usuarios">Usuários</a><% } %>
      <% if (user.tipo === 'admin') { %><a class="nav-link" href="/admin">Admin</a><% } %>
      <a class="nav-link" href="/conta#seguranca">Segurança</a>
    </nav>
    <div class="sidebar-card">
      <span class="eyebrow small">Empresa</span>
      <h3><%= user.nome_fantasia || user.razao_social || 'Sua empresa' %></h3>
      <p class="muted"><%= { usuario: 'Usuário', gestor: 'Gestor', admin: 'Administrador' }[user.tipo] %> · <%= user.empresa_status || 'Ativa' %></p>
    </div>
  </aside>

  <main class="page dashboard-page">
    <header class="page-heading dashboard-header">
      <div>
        <span class="eyebrow">DASHBOARD</span>
        <h1>Olá, <%= user.nome %>.</h1>
      </div>
      <div class="header-chip"><%= user.email %></div>
    </header>

    <section class="stats-grid" aria-label="Resumo do painel">
      <article class="stat-card">
        <span class="stat-label">Oportunidades em alta</span>
        <strong><%= dashboard?.oportunidades_totais ?? 0 %></strong>
        <small class="muted"><%= (dashboard?.topMatches?.length || 0) ? 'Últimos matches da empresa' : 'Nenhuma oportunidade registrada' %></small>
      </article>
      <article class="stat-card">
        <span class="stat-label">Interesses ativos</span>
        <strong><%= dashboard?.interesses_ativos ?? 0 %></strong>
        <small class="muted">Palavras-chave monitoradas</small>
      </article>
      <article class="stat-card">
        <span class="stat-label">Usuários ativos</span>
        <strong><%= dashboard?.usuarios_ativos ?? 0 %></strong>
        <small class="muted">Acesso da sua empresa</small>
      </article>
      <article class="stat-card accent">
        <span class="stat-label">Maior match</span>
        <strong><%= dashboard?.maior_score ?? 0 %>%</strong>
        <small class="muted">Melhor correlação atual</small>
      </article>
    </section>

    <div class="grid two dashboard-panels">
      <section class="panel">
        <h2>Oportunidades prioritárias</h2><p><a href="/oportunidades">Ver todas as oportunidades</a></p>
        <% if (dashboard?.topMatches?.length) { %>
          <ul class="check-list">
            <% for (const match of dashboard.topMatches) { %>
              <li><span class="dot ok"></span><strong><%= match.score %>%</strong> · <%= match.interesse_titulo %> — <%= match.objeto %> (<%= match.modalidade %>)</li>
            <% } %>
          </ul>
        <% } else { %>
          <p class="muted">Ainda não há oportunidades correlacionadas para esta empresa.</p>
        <% } %>
      </section>

      <section class="panel" id="seguranca">
        <h2>Segurança e acesso</h2>
        <form method="post" action="/conta/senha" class="stack compact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Senha atual<input type="password" name="senha_atual" autocomplete="current-password" required></label>
          <label>Nova senha<input type="password" name="senha" autocomplete="new-password" minlength="12" maxlength="72" required></label>
          <small class="muted">Mínimo de 12 caracteres; máximo de 72 bytes.</small>
          <button class="button" type="submit">Salvar nova senha</button>
        </form>
      </section>
    </div>

    <section class="panel section-gap profile-panel">
      <div class="panel-header">
        <h2>Perfil e permissões</h2>
        <span class="badge profile-badge"><%= { usuario: 'Usuário', gestor: 'Gestor', admin: 'Administrador' }[user.tipo] %></span>
      </div>
      <ul class="permission-list">
        <% const permissions = {
          usuario: ['Consultar a própria empresa', 'Visualizar dados do seu acesso', 'Não alterar cadastros da organização'],
          gestor: ['Editar dados da empresa', 'Gerenciar usuários da própria empresa', 'Criar e atualizar acessos do time'],
          admin: ['Acesso administrativo da empresa', 'Gerenciar permissões internas da conta', 'Supervisionar empresas e processamento das fontes']
        }[user.tipo]; %>
        <% for (const permission of permissions) { %>
          <li><span class="dot ok"></span><%= permission %></li>
        <% } %>
      </ul>
    </section>

    <section class="panel section-gap">
      <h2>Monitorar novas compras</h2><p>Cadastre os produtos e serviços da empresa para acompanhar oportunidades relacionadas ao seu negócio.</p>
      <a class="button" href="/interesses">Gerenciar interesses</a>
    </section>
    <section class="panel section-gap" id="alertas"><h2>Alertas por e-mail</h2>
      <% if (alertsSaved) { %><p class="notice" role="status">Preferência de alertas salva.</p><% } %>
      <p><%= emailEnabled ? 'Receba oportunidades com alta correlação no e-mail da sua conta.' : 'O envio de e-mails ainda não foi configurado pelo administrador. Você pode salvar sua preferência.' %></p>
      <form method="post" action="/conta/alertas" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Receber alertas<select name="alertas_email"><option value="false" <%= !user.alertas_email ? 'selected' : '' %>>Não receber</option><option value="true" <%= user.alertas_email ? 'selected' : '' %>>Receber no meu e-mail</option></select></label><button type="submit" class="button secondary">Salvar preferência</button>
      </form>
    </section>
    <% if (['gestor','admin'].includes(user.tipo)) { %>
    <section class="panel section-gap" id="whatsapp"><h2>Alertas pelo WhatsApp</h2>
      <% if (alertsSaved) { %><p class="notice" role="status">Preferências de alertas atualizadas.</p><% } %>
      <p>Como responsável pela empresa, você pode receber no WhatsApp os mesmos resumos de oportunidades enviados por e-mail.</p>
      <% if (!whatsappEnabled) { %><p class="muted">O envio ainda não foi configurado pelo administrador. Você pode salvar seu número e sua preferência.</p><% } %>
      <form method="post" action="/conta/whatsapp" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Seu celular com DDD<input type="tel" name="whatsapp_numero" autocomplete="tel" maxlength="30" placeholder="(84) 99999-9999" value="<%= user.whatsapp_numero || '' %>"></label>
        <label>Receber oportunidades no WhatsApp<select name="alertas_whatsapp"><option value="false" <%= !user.alertas_whatsapp ? 'selected' : '' %>>Não receber</option><option value="true" <%= user.alertas_whatsapp ? 'selected' : '' %>>Receber no WhatsApp</option></select></label>
        <label class="checkbox"><input type="checkbox" name="confirmar_whatsapp">Confirmo que este número é meu e quero receber alertas de oportunidades do LicitaMatch pelo WhatsApp.</label>
        <small class="muted">Confirme para ativar ou atualizar o recebimento. Para cancelar, escolha “Não receber” e salve. A preferência de e-mail é independente.</small>
        <button type="submit" class="button secondary">Salvar WhatsApp</button>
      </form>
    </section>
    <% } %>
  </main>
</div>
<%- include('../partials/footer') %>
