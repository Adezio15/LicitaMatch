<%- include('../partials/head') %>
<%- include('../partials/nav') %>
  <main class="page dashboard-page">
    <header class="page-heading dashboard-header">
      <div>
        <span class="eyebrow">DASHBOARD</span>
        <h1>Olá, <%= user.nome %>.</h1><p class="muted">Gerencie sua empresa e acompanhe suas oportunidades no LicitaMatch.</p>
      </div>
      <div class="header-chip"><%= user.email %></div>
    </header>
    <% if(user.teste_status === 'aguardando_aprovacao') { %><p class="notice" role="status">Sua solicitação de teste Premium foi enviada e está aguardando aprovação.</p><% } %>

    <section class="stats-grid" aria-label="Resumo do painel">
      <article class="stat-card">
        <span class="stat-label">Oportunidades encontradas</span>
        <strong><%= dashboard?.oportunidades_totais ?? 0 %></strong>
        <small class="muted"><%= ['start','sem_plano'].includes(user.plano) ? 'Resultados para suas áreas de interesse' : (dashboard?.topMatches?.length || 0) ? 'Últimos matches da empresa' : 'Nenhuma oportunidade registrada' %></small>
      </article>
      <article class="stat-card">
        <span class="stat-label">Interesses ativos</span>
        <strong><%= dashboard?.interesses_ativos ?? 0 %></strong>
        <small class="muted">Palavras-chave monitoradas</small>
      </article>
      <article class="stat-card">
        <span class="stat-label">Usuários ativos</span>
        <strong><%= dashboard?.usuarios_ativos ?? 0 %></strong>
        <small class="muted">Acesso da sua empresa</small>
      </article>
      <% if (['pro','premium'].includes(user.plano)) { %><article class="stat-card accent">
        <span class="stat-label">Match médio</span>
        <strong><%= dashboard?.score_medio ?? 0 %>%</strong>
        <small class="muted">Compatibilidade média atual</small>
      </article>
    <% } %><article class="stat-card"><span class="stat-label">Novas oportunidades</span><strong><%= dashboard.novas ?? 0 %></strong><small class="muted">Últimos 7 dias</small></article><article class="stat-card"><span class="stat-label">Plano atual</span><strong><%= {sem_plano:'Sem plano',start:'Start',pro:'Pro',premium:'Premium'}[user.plano] %></strong><small class="muted"><%= user.teste_status==='ativo' ? 'Teste Premium' : 'Plano da empresa' %></small></article></section>

    <section class="panel section-gap"><h2>Seu plano</h2><h3>Plano <%= user.teste_status === 'ativo' && user.plano_contratado !== 'premium' && user.plano === 'premium' ? 'Premium - Teste gratuito' : {sem_plano:'Sem plano',start:'Start',pro:'Pro',premium:'Premium'}[user.plano] %></h3>
    <% if(user.teste_status === 'ativo' && user.plano === 'premium' && user.plano_contratado !== 'premium') { %><p>Seu teste termina em: <time><%= new Date(user.teste_fim).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'}) %></time></p><p data-trial-end="<%= new Date(user.teste_fim).toISOString() %>"></p><% } %>
    <% if(user.plano === 'sem_plano') { %><p>Assine um plano para acessar todos os detalhes das oportunidades encontradas para sua empresa.</p><% } %>
    <% if(user.teste_status === 'expirado') { %><p class="notice">Seu período de teste Premium de 24 horas terminou.</p><% if(user.plano === 'sem_plano') { %><p>Escolha um dos planos do LicitaMatch para continuar acessando suas oportunidades.</p><% } } %>
    <button class="button" data-open-plans>Conhecer os planos</button></section>
    <section class="panel section-gap"><h2>Ações rápidas</h2><div class="quick-actions">
    <% for (const [href,label] of [['/interesses','◎ Áreas de interesse'],['/oportunidades','↗ Oportunidades'],['/empresa','▣ Minha empresa'],['/conta/seguranca','◇ Segurança']]) { %><a class="button secondary" href="<%= href %>"><%= label %></a><% } %><button class="button secondary" data-open-plans>✦ Plano e assinatura</button></div></section>
    <div class="grid dashboard-panels">
      <section class="panel">
        <% if (user.plano === 'sem_plano') { %><h2>Encontramos oportunidades para sua empresa.</h2><p>Encontramos <strong><%= dashboard.oportunidades_totais %></strong> oportunidades compatíveis com o perfil da sua empresa.</p><button class="button" data-open-plans>Desbloquear oportunidades</button><% } else if (user.plano === 'start') { %><p>Consulte a <a href="/busca">busca por segmento</a>. Match de compatibilidade exige upgrade para Pro ou Premium.</p><% } else { %>
        <h2>Oportunidades prioritárias</h2><p><a href="/oportunidades">Ver todas as oportunidades</a></p>
        <% if (dashboard?.topMatches?.length) { %>
          <ul class="check-list">
            <% for (const match of dashboard.topMatches) { %>
              <li><span class="dot ok"></span><strong><%= match.score %>%</strong> · <%= match.interesse_titulo %> — <%= match.objeto %> (<%= match.modalidade %>)</li>
            <% } %>
          </ul>
        <% } else { %>
          <p class="muted">Ainda não há oportunidades correlacionadas para esta empresa.</p>
        <% } %>
      <% } %></section>

    </div>
    <section class="panel section-gap">
      <h2>Monitorar novas compras</h2><p>Cadastre os produtos e serviços da empresa para acompanhar oportunidades relacionadas ao seu negócio.</p>
      <a class="button" href="/interesses">Gerenciar interesses</a>
    </section>
    <section class="panel section-gap" id="alertas"><h2>Alertas por e-mail</h2>
      <% if (alertsSaved) { %><p class="notice" role="status">Preferência de alertas salva.</p><% } %>
      <p><%= emailEnabled ? 'Receba oportunidades com alta correlação no e-mail da sua conta.' : 'O envio de e-mails ainda não foi configurado pelo administrador. Você pode salvar sua preferência.' %></p>
      <% if (['start','sem_plano'].includes(user.plano)) { %><p>Alertas por e-mail exigem upgrade para Pro ou Premium.</p><% } else { %><form method="post" action="/conta/alertas" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% const emailAlertsEnabled = user.alertas_email !== false; %>
        <label>Receber alertas<select name="alertas_email"><option value="false" <%= !emailAlertsEnabled ? 'selected' : '' %>>Não receber</option><option value="true" <%= emailAlertsEnabled ? 'selected' : '' %>>Receber no meu e-mail</option></select></label><button type="submit" class="button secondary">Salvar preferência</button>
      </form><% } %>
    </section>
    <% if (['gestor','admin'].includes(user.tipo)) { %>
    <section class="panel section-gap" id="whatsapp"><h2>Alertas pelo WhatsApp</h2>
      <% if (alertsSaved) { %><p class="notice" role="status">Preferências de alertas atualizadas.</p><% } %>
      <p>Como responsável pela empresa, você pode receber no WhatsApp os mesmos resumos de oportunidades enviados por e-mail.</p>
      <% if (!whatsappEnabled) { %><p class="muted">O envio ainda não foi configurado pelo administrador. Você pode salvar seu número e sua preferência.</p><% } %>
      <% if (user.plano !== 'premium') { %><p>Alertas pelo WhatsApp exigem upgrade para Premium.</p><% } else { %><form method="post" action="/conta/whatsapp" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Seu celular com DDD<input type="tel" name="whatsapp_numero" autocomplete="tel" maxlength="30" placeholder="(84) 99999-9999" value="<%= user.whatsapp_numero || '' %>"></label>
        <% const whatsappAlertsEnabled = user.alertas_whatsapp !== false; %>
        <label>Receber oportunidades no WhatsApp<select name="alertas_whatsapp"><option value="false" <%= !whatsappAlertsEnabled ? 'selected' : '' %>>Não receber</option><option value="true" <%= whatsappAlertsEnabled ? 'selected' : '' %>>Receber no WhatsApp</option></select></label>
        <label class="checkbox"><input type="checkbox" name="confirmar_whatsapp">Confirmo que este número é meu e quero receber alertas de oportunidades do LicitaMatch pelo WhatsApp.</label>
        <small class="muted">Confirme para ativar ou atualizar o recebimento. Para cancelar, escolha “Não receber” e salve. A preferência de e-mail é independente.</small>
        <button type="submit" class="button secondary">Salvar WhatsApp</button>
      </form><% } %>
    </section>
    <% } %>
  </main>
</div>
<%- include('../partials/plans') %>
<%- include('../partials/footer') %>
