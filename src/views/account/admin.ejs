<%- include('../partials/head') %>
<%- include('../partials/nav') %>
  <main class="page dashboard-page">
    <header class="page-heading dashboard-header">
      <div>
        <span class="eyebrow">PAINEL ADMINISTRATIVO</span>
        <h1>Painel global</h1>
      </div>
      <div class="header-chip"><%= user.email %></div>
    </header>

    <section class="stats-grid" aria-label="Resumo geral da plataforma">
      <article class="stat-card">
        <span class="stat-label">Empresas</span>
        <strong><%= data.summary?.empresas_totais ?? 0 %></strong>
        <small class="muted">Total de clientes ativos no sistema</small>
      </article>
      <article class="stat-card">
        <span class="stat-label">Empresas ativas</span>
        <strong><%= data.summary?.empresas_ativas ?? 0 %></strong>
        <small class="muted">Organizações em operação</small>
      </article>
      <article class="stat-card">
        <span class="stat-label">Usuários ativos</span>
        <strong><%= data.summary?.usuarios_ativos ?? 0 %></strong>
        <small class="muted">Acessos habilitados</small>
      </article>
      <article class="stat-card accent">
        <span class="stat-label">Interesses ativos</span>
        <strong><%= data.summary?.interesses_ativos ?? 0 %></strong>
        <small class="muted">Palavras-chave monitoradas</small>
      </article>
    </section>

    <section class="panel section-gap">
      <div class="panel-header">
        <h2>Empresas cadastradas</h2>
      </div>
      <% if (data.empresas?.length) { %>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Empresa</th>
                <th>CNPJ</th>
                <th>Status</th><th>Plano</th>
                <th>Usuários</th>
                <th>Interesses</th>
                <th>Matches</th><th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% for (const empresa of data.empresas) { %>
                <tr>
                  <td><strong><%= empresa.razao_social %></strong><br><small class="muted"><%= empresa.nome_fantasia || 'Sem nome fantasia' %></small></td>
                  <td><%= empresa.cnpj %></td>
                  <td><span class="badge"><%= empresa.status %></span></td>
                  <td><form method="post" action="/admin/empresas/<%= empresa.id %>/plano" class="stack">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% if(empresa.plano==='premium_teste') { %><p class="badge">Premium - Teste</p><% } %><label>Plano de <%= empresa.razao_social %><select name="plano">
                    <% for (const [value,label] of Object.entries({ sem_plano:'Sem plano', start: 'Start', pro: 'Pro', premium: 'Premium' })) { %>
                      <option value="<%= value %>" <%= empresa.plano === value ? 'selected' : '' %>><%= label %></option>
                    <% } %></select></label><button class="button small">Salvar plano</button>
                  </form></td>
                  <td><%= empresa.usuarios_ativos ?? 0 %></td>
                  <td><%= empresa.interesses_ativos ?? 0 %></td>
                  <td><%= empresa.oportunidades_totais ?? 0 %></td>
                  <td><a class="button secondary small" href="/admin/empresas/<%= empresa.id %>/perfil">Ver perfil</a><% if (String(empresa.id) !== String(user.empresa_id)) { %>
                    <form method="post" action="/admin/empresas/<%= empresa.id %>/excluir" data-delete-company data-company-name="<%= empresa.razao_social %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="button small danger">Excluir empresa</button>
                    </form>
                  <% } else { %><small class="muted">Sua empresa</small><% } %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">Ainda não existem empresas cadastradas na plataforma.</p>
      <% } %>
    </section>
  </main>
</div>
<script src="/assets/admin-companies.js" defer></script>
<%- include('../partials/footer') %>
