<%- include('../partials/head') %><%- include('../partials/nav') %><main class="page"><header class="page-heading"><h1>Testes Premium</h1><p>Analise solicitações e acompanhe o histórico permanente das empresas.</p></header><section class="panel table-scroll"><table><thead><tr><% for(const label of ['Empresa','CNPJ','Responsável','E-mail','Data da solicitação','Início','Término','Status','Ações']) { %><th><%= label %></th><% } %></tr></thead><tbody>
<% for(const t of trials) { %><tr><td><%= t.razao_social %></td><td><%= t.cnpj %></td><td><%= t.nome %></td><td><%= t.email %></td><% for(const d of [t.solicitado_em,t.inicio_em,t.fim_em]) { %><td><%= d ? new Date(d).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'}) : '—' %></td><% } %><td><span class="badge"><%= {aguardando_aprovacao:'Aguardando aprovação',ativo:'Ativo',recusado:'Recusado',expirado:'Expirado'}[t.status] %></span></td><td><details><summary>Visualizar detalhes</summary><p>IP: <%= t.ip_solicitacao || 'Não disponível' %></p><p>User-agent: <%= t.user_agent || 'Não disponível' %></p><p>Administrador: <%= t.aprovado_por || '—' %></p><p>Telefone: <%= t.telefone || '—' %></p></details><% if(t.status==='aguardando_aprovacao') { for(const action of ['aprovar','recusar']) { %><form method="post" action="/admin/testes-premium/<%= t.id %>/<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button small secondary" type="submit"><%= action==='aprovar' ? 'Aprovar' : 'Recusar' %></button></form><% } } %></td></tr><% } %>
<% if(!trials.length) { %><tr><td colspan="9">Nenhuma solicitação recebida.</td></tr><% } %></tbody></table></section></main></div><%- include('../partials/footer') %>
