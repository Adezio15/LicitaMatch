<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page">
  <h1>Busca por segmento</h1>
  <p>Licitações importadas automaticamente, filtradas pelas palavras-chave dos seus interesses. <a href="/interesses">Gerenciar segmentos e interesses</a>.</p>
  <% if (user.plano === 'start') { %><p class="notice">Match de compatibilidade e alertas por e-mail exigem upgrade para Pro ou Premium.</p><% } %>
  <% const stateQuery = (filters.uf || []).map(uf => '&uf=' + encodeURIComponent(uf)).join(''); %>
  <form method="get" class="panel grid two">
    <%- include('../partials/stateFilter', { states, filters }) %>
    <%- include('../partials/modalityFilter', { filters }) %>
    <label>Buscar no objeto<input name="q" maxlength="150" value="<%= filters.q %>"></label>
    <label>Segmento / interesse<select name="segmento"><option value="">Todos os interesses ativos</option>
      <% for (const interest of interests.filter(i => i.ativo)) { %><option value="<%= interest.id %>" <%= String(interest.id) === filters.segmento ? 'selected' : '' %>><%= interest.titulo %></option><% } %>
    </select></label><button class="button">Filtrar</button>
  </form>
  <p><%= total %> resultado(s)</p>
  <% for (const item of items) { %>
    <article class="panel section-gap"><h2><%= item.objeto %></h2><p><%= item.unidade_gestora %> · <%= item.modalidade %> · <%= item.uf %></p><p>Fonte: <%= { pncp: 'PNCP', comprasnet: 'Compras.gov.br' }[item.origem] || item.origem %></p>
      <%- include('../partials/officialLink', { item }) %>
    </article>
  <% } %>
  <% if (!items.length) { %><p>Nenhuma oportunidade encontrada. Revise os interesses e filtros.</p><% } %>
  <nav aria-label="Paginação" class="section-gap">
    <% if (filters.page > 1) { %><a href="?<%= stateQuery.slice(1) %>&amp;modalidade=<%= encodeURIComponent(filters.modalidade || '') %>&amp;page=<%= filters.page-1 %>&amp;q=<%= encodeURIComponent(filters.q) %>&amp;segmento=<%= filters.segmento %>">Anterior</a><% } %>
    Página <%= filters.page %> de <%= pages %>
    <% if (filters.page < pages) { %><a href="?<%= stateQuery.slice(1) %>&amp;modalidade=<%= encodeURIComponent(filters.modalidade || '') %>&amp;page=<%= filters.page+1 %>&amp;q=<%= encodeURIComponent(filters.q) %>&amp;segmento=<%= filters.segmento %>">Próxima</a><% } %>
  </nav>
</main></div>
<script src="/assets/opportunity-filters.js" defer></script>
<%- include('../partials/footer') %>
