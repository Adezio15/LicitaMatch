<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page dashboard-page">
  <header class="page-heading"><span class="eyebrow">RELATÓRIOS</span><h1><%= title %></h1>
    <p>Consulte os resultados da sua empresa e confira cada licitação na fonte oficial.</p>
  </header>
  <nav class="report-tabs" aria-label="Tipos de relatório">
    <% for (const [key,label] of Object.entries(reportTitles)) { %>
      <a class="button <%= tipo === key ? '' : 'secondary' %>" href="/relatorios?<%= reportQuery({tipo:key,page:1}) %>" <% if (tipo===key) { %>aria-current="page"<% } %>><%= label %></a>
    <% } %>
  </nav>
  <form method="get" action="/relatorios" class="panel report-filters section-gap">
    <input type="hidden" name="tipo" value="<%= tipo %>">
    <label>De<input type="date" name="inicio" value="<%= filters.inicio %>" required></label>
    <label>Até<input type="date" name="fim" value="<%= filters.fim %>" required></label>
    <label>Interesse<select name="interesse"><option value="">Todos</option>
      <% for (const interest of interests) { %><option value="<%= interest.id %>" <%= filters.interesse===String(interest.id) ? 'selected' : '' %>><%= interest.titulo %><%= interest.ativo ? '' : ' (inativo)' %></option><% } %>
    </select></label>
    <label>Órgão<input name="orgao" value="<%= filters.orgao %>" maxlength="200" placeholder="Nome ou parte do nome"></label>
    <label>Estado<select name="estado"><option value="">Todos</option><% for (const uf of states) { %><option value="<%= uf %>" <%= filters.estado===uf ? 'selected' : '' %>><%= uf %></option><% } %></select></label>
    <label>Match mínimo (%)<input type="number" name="match_min" min="0" max="100" value="<%= filters.match_min %>" required></label>
    <label>Match máximo (%)<input type="number" name="match_max" min="0" max="100" value="<%= filters.match_max %>" required></label>
    <button class="button" type="submit">Aplicar filtros</button>
  </form>
  <div class="panel-header section-gap"><p><%= total %> registro(s)</p>
    <a class="button secondary" href="/relatorios/pdf?<%= reportQuery({page:1}) %>">Exportar em PDF</a>
  </div>
  <p class="muted">O período considera a identificação do match e, para alertas, a data de envio (horário de Brasília). Situações e percentuais refletem o estado atual. O PDF inclui todas as páginas dos filtros selecionados, até 2.000 registros.</p>
  <% if (tipo==='oportunidades') { %><p class="muted">Cada licitação aparece uma vez, com o maior match entre os interesses selecionados.</p><% } %>
  <% if (!rows.length) { %><section class="panel"><h2>Nenhum resultado</h2><p>Revise o período e os filtros selecionados.</p></section><% } else { %>
  <section class="panel table-scroll">
    <table>
      <caption><%= reportTitles[tipo] %></caption>
      <% if (tipo==='matches') { %>
        <thead><tr><th>Faixa de match</th><th>Quantidade de matches</th><th>Percentual médio</th></tr></thead><tbody>
          <% for (const row of rows) { %><tr><td><%= row.faixa %></td><td><%= row.total %></td><td><%= row.score_medio %>% <meter min="0" max="100" value="<%= row.score_medio %>" aria-label="Percentual médio"></meter></td></tr><% } %>
        </tbody>
      <% } else if (tipo==='mensal') { %>
        <thead><tr><th>Mês</th><th>Oportunidades</th><th>Matches</th><th>Match médio</th><th>Matches aceitos</th><th>E-mails enviados</th><th>WhatsApp enviados</th></tr></thead><tbody>
          <% for (const row of rows) { %><tr><td><%= row.mes %></td><td><%= row.oportunidades %></td><td><%= row.matches %></td><td><%= row.score_medio %>%</td><td><%= row.aceitos %></td><td><%= row.emails %></td><td><%= row.whatsapp %></td></tr><% } %>
        </tbody>
      <% } else { %>
        <thead><tr><th>Título / interesse</th><th>Órgão</th><th>Cidade/UF</th><th>Match</th><th>Datas</th><th>Situação</th><% if (tipo==='alertas') { %><th>Envio</th><% } %><th>Fonte oficial</th></tr></thead><tbody>
          <% for (const row of rows) { %><tr>
            <td><strong><%= row.titulo %></strong><br><small><%= row.interesse_titulo %></small></td>
            <td><%= row.orgao %></td><td><%= row.cidade || 'Cidade não informada' %> / <%= row.uf || 'UF não informada' %></td>
            <td><%= row.score %>%</td><td>Encontrada: <%= reportDate(row.encontrada_em) %><br>Licitação: <%= reportDate(row.data_abertura) %></td>
            <td><%= statusLabels[row.status] || row.status %></td>
            <% if (tipo==='alertas') { %><td><%= row.canal==='email' ? 'E-mail' : 'WhatsApp' %><br><%= reportDate(row.enviado_em) %></td><% } %>
            <td><%- include('../partials/officialLink',{urlFonte:row.url_fonte}) %></td>
          </tr><% } %>
        </tbody>
      <% } %>
    </table>
  </section>
  <% } %>
  <nav class="report-tabs section-gap" aria-label="Paginação">
    <% if (filters.page>1) { %><a class="button secondary" href="/relatorios?<%= reportQuery({page:filters.page-1}) %>">Anterior</a><% } %>
    <span>Página <%= filters.page %> de <%= pages %></span>
    <% if (filters.page<pages) { %><a class="button secondary" href="/relatorios?<%= reportQuery({page:filters.page+1}) %>">Próxima</a><% } %>
  </nav>
</main></div>
<%- include('../partials/footer') %>
