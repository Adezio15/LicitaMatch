# Referência para variáveis no Railway. O app não carrega este arquivo automaticamente.
NODE_ENV=production
LOCAL_DATABASE=false
APP_TIMEZONE=America/Fortaleza
LOG_LEVEL=info
# Ajuste à quantidade real de proxies confiáveis no deploy.
TRUST_PROXY_HOPS=1
# URL com pooling fornecida pelo Neon, para a aplicação.
DATABASE_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT-pooler.REGIAO.aws.neon.tech/neondb?sslmode=verify-full
# URL direta do MESMO banco, sem -pooler, para migrations.
DATABASE_DIRECT_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
SESSION_SECRET=SUBSTITUA_POR_UM_NOVO_SEGREDO_ALEATORIO_DE_PELO_MENOS_48_CARACTERES
# PORT é fornecida pelo Railway. Nunca configure SEED_USER_PASSWORD em produção.
