# Referência para variáveis no Railway. O app não carrega este arquivo automaticamente.
NODE_ENV=production
LOCAL_DATABASE=false
APP_TIMEZONE=America/Fortaleza
LOG_LEVEL=info
# Ajuste à quantidade real de proxies confiáveis no deploy.
TRUST_PROXY_HOPS=1
# URL com pooling fornecida pelo Neon, para a aplicação.
DATABASE_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT-pooler.REGIAO.aws.neon.tech/neondb?sslmode=verify-full
# URL direta do MESMO banco, sem -pooler, para migrations.
DATABASE_DIRECT_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
SESSION_SECRET=SUBSTITUA_POR_UM_NOVO_SEGREDO_ALEATORIO_DE_PELO_MENOS_48_CARACTERES
# PORT é fornecida pelo Railway. Use SEED_USER_PASSWORD apenas temporariamente para admin:create.

# Cadastro operacional: npm run admin:create (não executado no startup)
# Configure temporariamente a senha nas Variables do Railway.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_ROLE=admin
# ID de empresa existente e ativa; necessário para criar novo administrador.
SEED_COMPANY_ID=

# Worker usa DATABASE_DIRECT_URL: locks de sessão não aceitam transaction pooling.
WORKER_ENABLED=true
SYNC_ENABLED=true
COMPRASNET_ENABLED=true
SENAC_ENABLED=true
SESC_ENABLED=true
RECIFE_ENABLED=true
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=2
SYNC_MAX_PAGES=5
PNCP_MODALIDADES=4,6,7,8,9,12
COMPRASNET_MODALIDADES=3,5,6,7
# Sem flag explícita, cada canal é ativado ao completar suas credenciais abaixo.
# false desativa o canal; true exige configuração completa.
# EMAIL_ENABLED=true
# Para HTTPS (todos os planos Railway), use domínio verificado no Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=configure-no-ambiente
# EMAIL_FROM=alertas@seu-dominio.com.br
# Para SMTP, use EMAIL_PROVIDER=smtp (Railway exige plano Pro ou superior).
ALERT_MIN_SCORE=70
# Twilio: ativação explícita somente após configurar e testar o Sandbox.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=sandbox
WHATSAPP_WEBHOOK_URL=https://licitamatch.online/api/whatsapp/webhook
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=configure-somente-no-ambiente
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Números brasileiros E.164, separados por vírgulas, que aderiram ao Sandbox.
WHATSAPP_SANDBOX_NUMBERS=
# Produção permanece bloqueada até remetente comercial e template aprovados.
WHATSAPP_PRODUCTION_READY=false
# TWILIO_WHATSAPP_CONTENT_SID=HX...

# Ative somente após configurar remetente e credenciais SMTP reais.
# EMAIL_FROM=alertas@seu-dominio.com.br
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_USER=seu-usuario
# SMTP_PASSWORD=configure-no-ambiente

# Destinatário administrativo para novas solicitações de teste/contratação.
# Sem ADMIN_EMAIL, utiliza os administradores ativos cadastrados.
ADMIN_EMAIL=
